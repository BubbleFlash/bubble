{
  "name": "@commune/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "build:vercel": "tsup && node scripts/prepare-vercel.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "make-admin": "tsx src/scripts/makeAdmin.ts",
    "preview:mail": "tsup src/scripts/previewMail.ts --no-config --format esm --target node20 --out-dir dist/mail-tool && node dist/mail-tool/previewMail.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-presigned-post": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@commune/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.12.3",
    "multer": "^2.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "supertest": "^7.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.19.1",
    "vitest": "^5.1.1"
  }
}
